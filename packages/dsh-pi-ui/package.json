{
  "name": "@local/dsh-pi-ui",
  "version": "1.0.0",
  "description": "DSH 界面综合增强插件：复刻 pi-web-ui 经典底部状态指标条（Token/运行状态）、输入框快捷指令芯片栏、轻量随手记便签与现代视觉主题优化。",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
